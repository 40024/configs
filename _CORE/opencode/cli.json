{
  "$schema": "https://opencode.ai/v2/cli.json",
  "tabs": {
    "mode": "auto"
  },
  "session": {
    "permissions": "prompt",
    "sidebar": "auto",
    "verbosity": "medium",
    "new_location": "launch"
  },
  "keybinds": {
    "leader": "ctrl+x",
    "open.menu": ["ctrl+o", "<leader>o", "<leader>w"],
    "help.show": "<leader>shift+/",
    "prompt.editor": ["ctrl+s", "<leader>e"],
    "session.tab.next": ["<leader>j", "shift+l"],
    "session.tab.previous": ["<leader>p", "shift+k"],

    "session.export": "<leader>shift+x",
    "session.tab.close": "<leader>x",

    "session.new": "<leader>c",
    "session.compact": "<leader>shift+c"
  },
  "animations": true,
  "terminal": {
    "copy": "select"
  }
}
